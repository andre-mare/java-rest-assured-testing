{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/payment.schema.json",
  "title": "Domestic payment",
  "description": "A payment as GET and POST /pisp/v1/domestic-payments return it.",
  "type": "object",
  "required": ["paymentId", "instructionId", "status", "debtor", "creditor", "amount", "createdAt", "_links"],
  "additionalProperties": false,
  "properties": {
    "paymentId": { "type": "string", "pattern": "^pmt-[0-9]+$" },
    "instructionId": { "type": "string", "minLength": 1, "maxLength": 35 },
    "status": { "enum": ["RCVD", "PDNG", "ACSP", "ACSC", "RJCT"] },
    "debtor": { "$ref": "#/$defs/party" },
    "creditor": { "$ref": "#/$defs/party", "required": ["iban", "name"] },
    "amount": { "$ref": "#/$defs/amount" },
    "remittanceInformation": { "type": "string", "maxLength": 140 },
    "requestedExecutionDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "_links": {
      "type": "object",
      "required": ["self"],
      "properties": { "self": { "$ref": "#/$defs/link" } }
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "required": ["iban"],
      "properties": {
        "iban": { "type": "string", "pattern": "^[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}$" },
        "name": { "type": "string", "maxLength": 70 }
      }
    },
    "amount": {
      "type": "object",
      "required": ["value", "currency"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "pattern": "^[0-9]{1,13}\\.[0-9]{2}$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "link": {
      "type": "object",
      "required": ["href"],
      "properties": { "href": { "type": "string", "pattern": "^/" } }
    }
  }
}
