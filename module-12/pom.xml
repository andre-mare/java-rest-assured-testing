<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.example</groupId>
		<artifactId>java-rest-assured-testing</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>module-12</artifactId>
	<name>Module 12: Real infrastructure with Testcontainers</name>

	<dependencies>
		<dependency>
			<groupId>tools.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<!-- @Testcontainers and @Container (Testcontainers 2 renamed the module from junit-jupiter) -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- A ready-made Keycloak container with realm import -->
		<dependency>
			<groupId>com.github.dasniko</groupId>
			<artifactId>testcontainers-keycloak</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!-- Run a slice of the suite by tag (section 3). Surefire reads the groups and excludedGroups properties. -->
	<profiles>
		<profile>
			<id>smoke</id>
			<properties>
				<groups>smoke</groups>
			</properties>
		</profile>
		<profile>
			<id>security</id>
			<properties>
				<groups>security</groups>
			</properties>
		</profile>
		<profile>
			<id>no-docker</id>
			<properties>
				<excludedGroups>keycloak,expected-failure-tests</excludedGroups>
			</properties>
		</profile>
	</profiles>

</project>
